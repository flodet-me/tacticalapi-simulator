<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
    <!-- Always emit PDBs (portable, cross-platform) so build/publish/Docker
         outputs are debuggable, regardless of configuration. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- Base semantic version. CI appends a VersionSuffix (run number + commit
         sha) so every pipeline run produces a unique, traceable version. -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- NuGet's built-in vulnerability audit (restore-time) only checks direct
         PackageReferences by default; extend it to transitive dependencies
         too. TreatWarningsAsErrors above means a detected vulnerability
         already fails the build, not just CI's separate "Vulnerability scan"
         step. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Microsoft.NET.Sdk.Web sets this to the project directory itself (so
         `dotnet run` finds appsettings.json regardless of the caller's cwd);
         plain Microsoft.NET.Sdk console apps don't, and would otherwise load
         config relative to wherever `dotnet run`/the shell happened to be
         invoked from. Set it repo-wide so every executable here - Host and
         every Adapter.* - behaves the same way. -->
    <RunWorkingDirectory Condition="'$(RunWorkingDirectory)' == ''">$(MSBuildProjectDirectory)</RunWorkingDirectory>
  </PropertyGroup>
</Project>
