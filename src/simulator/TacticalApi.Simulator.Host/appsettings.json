{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    },
    "File": {
      "Enabled": false,
      "Path": "logs/host-.jsonl"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "GrpcWeb": {
        "Url": "http://0.0.0.0:4268",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:5100",
        "Protocols": "Http2"
      }
    }
  },
  "Simulator": {
    "ReporterId": "TacticalAPI-Simulator",
    "ExpirySweepInterval": "00:00:10",
    "MapUi": {
      "Enabled": true,
      "RefreshInterval": "00:00:02",
      "DefaultCenterLatitude": 53.08,
      "DefaultCenterLongitude": 8.8,
      "DefaultZoom": 9
    },
    "Performance": {
      "SubscriberChannelCapacity": 4096,
      "SubscriberChannelFullMode": "DropOldest",
      "StreamBatchSize": 256,
      "MaxReceiveMessageSizeMb": 16,
      "MaxSituationObjects": 100000
    }
  }
}
