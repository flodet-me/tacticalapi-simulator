<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Performance: server GC + concurrent GC for a long-running streaming server. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPgo>true</TieredPgo>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TacticalApi.Simulator.Core\TacticalApi.Simulator.Core.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore"/>
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection"/>
    <PackageReference Include="Grpc.AspNetCore.Web"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded alongside the usual Content copy so AppSettingsBootstrap can
         regenerate appsettings.json from this exact file if it's ever missing
         next to the running executable. -->
    <EmbeddedResource Include="appsettings.json"/>
  </ItemGroup>

</Project>
