<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the C# data model + service stubs directly from the official
    TacticalAPI .proto contract. No internal abstraction on top: the generated
    Rheinmetall.TacticalApi.V0 types ARE the model used everywhere.

    The protos live in /protos (copied verbatim from
    https://github.com/Rheinmetall/tacticalapi). If you prefer a git submodule,
    point ProtoRoot at the submodule path instead - nothing else changes.
  -->

  <PropertyGroup>
    <ProtoRoot>$(MSBuildThisFileDirectory)..\..\external\tacticalapi</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\rheinmetall\tactical_api\v0\*.proto"
              ProtoRoot="$(ProtoRoot)"
              GrpcServices="Both"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf"/>
    <PackageReference Include="Grpc.Core.Api"/>
    <PackageReference Include="Grpc.Tools" PrivateAssets="all"/>
  </ItemGroup>

</Project>
