{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Grpc": "Warning"
    },
    "File": {
      "Enabled": false,
      "Path": "logs/adapter-replay-.jsonl"
    }
  },
  "Adapter": {
    "Ingest": {
      "Address": "http://localhost:5100"
    },
    "Recorder": {
      "Enabled": false,
      "Path": "recordings/recording.jsonl",
      "IncludeInitialSnapshot": true
    },
    "Replay": {
      "Enabled": false,
      "Path": "recordings/recording.jsonl",
      "Speed": 1.0,
      "Loop": false,
      "TickInterval": "00:00:00.100",
      "RestampReportingTime": true
    }
  }
}
